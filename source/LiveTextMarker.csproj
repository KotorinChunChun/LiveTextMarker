<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LiveTextMarker</AssemblyName><Product>LiveTextMarker</Product><Title>LiveTextMarker</Title><RootNamespace>LiveTextMarker</RootNamespace>
    <PublishSingleFile>false</PublishSingleFile><Platforms>x64</Platforms>
    <Version>1.1.0</Version><ApplicationIcon>assets/LiveTextMarker.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Tesseract" Version="5.2.0" /></ItemGroup>
  <ItemGroup><Content Include="tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Compile Remove="tests\**" /><EmbeddedResource Include="assets/LiveTextMarker.ico" LogicalName="LiveTextMarker.AppIcon" /></ItemGroup>
</Project>
